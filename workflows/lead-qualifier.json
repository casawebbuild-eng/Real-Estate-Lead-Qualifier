        "jsCode": "// Fixed acknowledgment templates. Only name, intent and a sanitized area are inserted.\n// No model-written text, no prices, no availability, no viewing promises.\n\nconst lead = $('Score').first().json;\nconst cfg = $('Config').first().json;\n\n// Allow letters (any script), digits, spaces and a few separators. Cap at 40 chars.\nconst clean = (s, max) => String(s ?? '')\n  .replace(/[^\\p{L}\\p{N} .,'’\\-]/gu, '')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .slice(0, max);\n\nconst lang = ['fr', 'ar', 'en'].includes(lead.language) ? lead.language : 'en';\nconst name = clean(lead.name, 60) || (lang === 'fr' ? 'Madame, Monsieur' : lang === 'ar' ? 'عميلنا الكريم' : 'there');\nconst area = clean(lead.area, 40);\n\n// intent is an enum from the schema, but we re-validate it here anyway.\nconst intentLabels = {\n  fr: { buy: 'un achat', rent: 'une location', unknown: 'votre projet immobilier' },\n  ar: { buy: 'الشراء', rent: 'الإيجار', unknown: 'مشروعكم العقاري' },\n  en: { buy: 'buying a property', rent: 'renting a property', unknown: 'your property project' },\n};\nconst intent = ['buy', 'rent', 'unknown'].includes(lead.intent) ? lead.intent : 'unknown';\nconst what = intentLabels[lang][intent];\n\nconst areaFr = area ? ` dans le secteur « ${area} »` : '';\nconst areaAr = area ? ` في منطقة «${area}»` : '';\nconst areaEn = area ? ` in ${area}` : '';\n\nconst templates = {\n  fr: {\n    subject: 'Nous avons bien reçu votre demande',\n    body:\n`Bonjour ${name},\n\nMerci de nous avoir contactés. Nous avons bien reçu votre demande concernant ${what}${areaFr}.\n\nUn conseiller de l'agence l'examinera et reviendra vers vous.\n\nCordialement,\nL'équipe de l'agence`,\n  },\n  ar: {\n    subject: 'لقد استلمنا طلبكم',\n    body:\n`مرحباً ${name}،\n\nشكراً لتواصلكم معنا. لقد استلمنا طلبكم بخصوص ${what}${areaAr}.\n\nسيقوم أحد مستشاري الوكالة بمراجعته والرد عليكم.\n\nمع أطيب التحيات،\nفريق الوكالة`,\n  },\n  en: {\n    subject: 'We have received your request',\n    body:\n`Hello ${name},\n\nThank you for contacting us. We have received your request about ${what}${areaEn}.\n\nAn advisor from the agency will review it and get back to you.\n\nKind regards,\nThe agency team`,\n  },\n};\n\nconst t = templates[lang];\n\n// TEST_MODE: every email goes to the test address until test_mode is set to false in Config.\nconst to = cfg.test_mode === true ? cfg.test_email : lead.email;\n\nreturn [{ json: { to, subject: t.subject, body: t.body, language: lang, test_mode: cfg.test_mode === true } }];"
      },
